page {
  min-height: 100%;
  background: linear-gradient(180deg, #fff7f5 0%, #f6f2f1 45%, #ffffff 100%);
  color: #2a1d1a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}
.container {
  padding: 28rpx;
  box-sizing: border-box;
}
.card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 42rpx rgba(255, 0, 54, 0.09);
  border: 1rpx solid rgba(255, 0, 54, 0.08);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #21110f;
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff0036, #ff7a00);
  margin-right: 14rpx;
}
.input, .picker {
  height: 84rpx;
  line-height: 84rpx;
  background: #fff8f7;
  border: 1rpx solid #f0d9d6;
  border-radius: 18rpx;
  padding: 0 22rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}
.textarea {
  min-height: 132rpx;
  background: #fff8f7;
  border: 1rpx solid #f0d9d6;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
  width: 100%;
}
.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0 18rpx;
}
.form-grid .full {
  grid-column: 1 / span 2;
}
.primary-btn, .ghost-btn, .danger-btn {
  border-radius: 999rpx;
  font-weight: 700;
  margin: 10rpx 0;
}
.primary-btn {
  color: #fff;
  background: linear-gradient(135deg, #ff0036, #ff6a00);
  box-shadow: 0 12rpx 24rpx rgba(255, 0, 54, 0.22);
}
.ghost-btn {
  color: #ff0036;
  background: #fff0f2;
  border: 1rpx solid rgba(255, 0, 54, 0.18);
}
.danger-btn {
  color: #fff;
  background: #2c1b18;
}
.toolbar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 18rpx;
}
.toolbar button {
  flex: 1;
  font-size: 26rpx;
}
.record {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1e0dd;
}
.record:last-child {
  border-bottom: none;
}
.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.record-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a1714;
}
.record-sub, .muted {
  color: #8d7872;
  font-size: 24rpx;
  line-height: 1.7;
}
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff0f2;
  color: #ff0036;
  font-size: 22rpx;
  margin-right: 8rpx;
}
.amount {
  color: #ff0036;
  font-weight: 800;
}
.empty {
  text-align: center;
  color: #b09b95;
  padding: 50rpx 0;
}
