.login-page {
  min-height: 100vh;
  padding: 90rpx 32rpx 32rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at 16% 10%, rgba(255, 122, 0, 0.25), transparent 28%), linear-gradient(160deg, #ff0036 0%, #ff4d55 48%, #fff3ef 48%, #ffffff 100%);
}
.brand-card {
  color: #fff;
  padding: 46rpx 18rpx 80rpx;
}
.brand-mark {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.2);
  font-size: 54rpx;
  font-weight: 900;
  margin-bottom: 26rpx;
}
.brand-title {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.brand-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.86;
}
.login-card {
  margin-top: -28rpx;
}
